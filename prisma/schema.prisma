// Prisma Schema — CicekanaTekmedia Full Platform
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth v5 / @auth/prisma-adapter) ────────────────────────────────

model User {
  id                      String                  @id @default(cuid())
  name                    String?
  email                   String                  @unique
  emailVerified           DateTime?
  isEmailVerified         Boolean                 @default(false)
  phone                   String?
  image                   String?
  passwordHash            String?
  role                    UserRole                @default(EDITOR)
  isActive                Boolean                 @default(true)
  lastLoginAt             DateTime?
  companyTitle            String?
  taxNumber               String?
  taxOffice               String?
  sector                  String?
  accountType             String                  @default("individual")
  brandLogo               String?
  brandColor              String?
  notificationPrefs       Json?
  accounts                Account[]
  sessions                Session[]
  blogPosts               BlogPost[]
  orders                  Order[]
  addresses               Address[]
  clientProjects          ClientProject[]
  performanceReports      PerformanceReport[]
  supportTickets          SupportTicket[]
  clientInvoices          ClientInvoice[]
  clientContracts         ClientContract[]
  activityLogs            ActivityLog[]
  teamMembers             ClientTeamMember[]

  // ─── PayTR Abonelik / Ödeme Tabloları ──────────────────────────────
  savedPaymentCards       SavedPaymentCard[]
  subscriptions           Subscription[]
  paymentAttempts         PaymentAttempt[]

  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  firstName     String
  lastName      String
  phone         String
  city          String
  district      String
  addressDetail String   @db.Text
  zipCode       String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Leads / CRM ──────────────────────────────────────────────────────────────

model Lead {
  id           String     @id @default(cuid())
  companyName  String
  sector       String
  solutionType String[]
  timeline     String
  email        String
  brief        String?    @db.Text
  status       LeadStatus @default(NEW)
  notes        LeadNote[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
}

// ─── Clients & Partners (Homepage Marquees) ────────────────────────────────────

model Client {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String
  websiteUrl   String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String
  websiteUrl   String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  content         Json
  excerpt         String?    @db.Text
  featuredImage   String?
  category        String
  tags            String[]
  metaDescription String?
  readTime        Int        @default(5) // minutes
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  authorId        String
  author          User       @relation(fields: [authorId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ─── Projects / Case Studies ───────────────────────────────────────────────────

model Project {
  id         String     @id @default(cuid())
  title      String
  slug       String     @unique
  client     String
  year       Int
  category   String
  challenge  String?    @db.Text
  solution   String?    @db.Text
  metrics    Json?      // [{ label: string, value: string }]
  heroImage  String?
  images     String[]
  techTags   String[]
  pdfUrl     String?
  status     PostStatus @default(DRAFT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ─── Products & E-Commerce ────────────────────────────────────────────────────

enum ProductCategory {
  Medya
  Teknoloji
  Baski
}

model Product {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  description          String?             @db.Text
  category             ProductCategory     @default(Teknoloji)
  subcategory          String?
  price                Float               @default(0)
  images               String[]
  stock                Int?                // null = unlimited
  isActive             Boolean             @default(true)
  isFeatured           Boolean             @default(false)
  customizationOptions Json?
  photoToDesignFee     Float?              @default(500)

  // ─── Abonelik Ürünü Desteği ─────────────────────────────────────────
  isSubscription       Boolean             @default(false)
  defaultMonthlyPrice  Float?

  subscriptions        Subscription[]
  subscriptionPlans    SubscriptionPlan[]

  // Cross-sells (self-relation)
  crossSells           Product[]           @relation("CrossSell")
  crossSelledBy        Product[]           @relation("CrossSell")

  cartItems            CartItem[]
  orderItems           OrderItem[]
  reviews              Review[]
  variants             ProductVariant[]
  designTemplates      DesignTemplate[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int
  material     String?
  unitCost     Float?
  totalCost    Float?
  salePrice    Float
  unitSalePrice Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

model DesignTemplate {
  id            String   @id @default(cuid())
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  subcategory   String?
  nicheLabels   String[]
  frontImage    String?
  backImage     String?
  frontImageUrl String?
  backImageUrl  String?
  isActive      Boolean  @default(true)
  orderItems    OrderItem[] @relation("OrderItemTemplate")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
}

model CartItem {
  id               String   @id @default(cuid())
  sessionId        String?  // for guests
  userId           String?  // for logged-in users
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int      @default(1)
  customizationData Json?   // Stores customer's filled-in values
  price            Float    // snapshot price
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique // human-readable
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName       String?
  guestEmail      String?
  items           OrderItem[]
  status          OrderStatus     @default(PENDING)
  totalAmount     Float
  discountAmount  Float           @default(0)
  finalAmount     Float
  paymentMethod   String?
  paymentStatus   String          @default("PENDING") // PENDING, COMPLETED, FAILED
  shippingAddress Json?
  masterpassToken String?
  trackingNumber  String?
  carrier         String?
  notes           String?         @db.Text
  paymentAttempts PaymentAttempt[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  quantity         Int
  unitPrice        Float
  customizationData Json?
  selectedTemplateId String?
  selectedTemplate  DesignTemplate? @relation("OrderItemTemplate", fields: [selectedTemplateId], references: [id])
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  guestName          String?
  rating             Int      // 1-5
  text               String   @db.Text
  images             String[]
  adminReply         String?  @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  createdAt          DateTime @default(now())
}

enum DiscountType {
  PERCENTAGE
  FIXED
  TIERED
  CART_THRESHOLD
}

model DiscountCampaign {
  id             String       @id @default(cuid())
  name           String
  type           DiscountType
  value          Float?       // Or tieredRules inside JSON if needed
  tieredRules    Json?        // For tiered discounts
  couponCode     String?      @unique
  minCartAmount  Float?
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CartAbandonmentLog {
  id            String    @id @default(cuid())
  sessionId     String?
  userId        String?
  cartSnapshot  Json
  emailSentAt   DateTime?
  reminderCount Int       @default(0)
  converted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

// ─── Services ─────────────────────────────────────────────────────────────────

model Service {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  iconName        String     @default("Zap")
  shortDesc       String?
  fullDescription Json?
  keyFeatures     String[]
  heroImage       String?
  revealImage1    String?
  revealImage2    String?
  displayOrder    Int        @default(0)
  isActive        Boolean    @default(true)
  status          PostStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ─── Team ─────────────────────────────────────────────────────────────────────

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  title        String
  bio          String?  @db.Text
  photoUrl     String?
  linkedinUrl  String?
  expertise    String[]
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Testimonials ─────────────────────────────────────────────────────────────

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  title        String
  company      String
  quote        String   @db.Text
  avatarUrl    String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ─── FAQ ──────────────────────────────────────────────────────────────────────

model FAQ {
  id           String   @id @default(cuid())
  question     String
  answer       String   @db.Text
  category     String   @default("Genel")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Quotes / Proposals ───────────────────────────────────────────────────────

model Quote {
  id          String      @id @default(cuid())
  companyName String
  email       String
  items       QuoteItem[]
  terms       String?     @db.Text
  validUntil  DateTime?
  status      QuoteStatus @default(DRAFT)
  pdfUrl      String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service     String
  description String?
  price       Float
  quantity    Int    @default(1)
}

// ─── Email Campaigns ──────────────────────────────────────────────────────────

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  html      String   @db.Text
  variables String[] // e.g. ["name", "company"]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id         String   @id @default(cuid())
  recipient  String
  subject    String
  templateId String?
  status     String   @default("sent") // sent | delivered | bounced | failed
  sentAt     DateTime @default(now())
}

// ─── Sungur / CrewAI ──────────────────────────────────────────────────────────

model CrewRun {
  id          String    @id @default(cuid())
  agentType   String
  inputData   Json
  status      RunStatus @default(PENDING)
  output      String?   @db.Text
  logs        String?   @db.Text
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

// ─── Site Settings (singleton) ────────────────────────────────────────────────

model SiteSettings {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─── Client Portal (Kurumsal Müşteri Paneli) ───────────────────────────────────

model ClientProject {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  serviceType           String               // "web_development" | "ecommerce" | "social_media" | "advertising" | "consulting" | "call_center_ai"
  status                String               // "planning" | "development" | "testing" | "live" | "on_hold" | "completed"
  progressPercent       Int                  @default(0)
  startDate             DateTime?
  endDate               DateTime?
  isSubscription        Boolean              @default(false)
  subscriptionTier      String?              // "basic" | "pro" | "enterprise"
  renewalDate           DateTime?
  accountManagerName    String?
  accountManagerContact String?
  milestones            ProjectMilestone[]
  deliverables          ProjectDeliverable[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([userId])
}

model ProjectMilestone {
  id        String        @id @default(cuid())
  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    String        // "pending" | "in_progress" | "done"
  dueDate   DateTime?
  order     Int           @default(0)

  @@index([projectId])
}

model ProjectDeliverable {
  id         String        @id @default(cuid())
  projectId  String
  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String        // "design" | "source_code" | "report" | "contract" | "other"
  uploadedAt DateTime      @default(now())

  @@index([projectId])
}

model PerformanceReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  title       String
  periodStart DateTime
  periodEnd   DateTime
  pdfUrl      String?
  summaryJson Json?    // {"visits": [...], "sales": [...], "adSpend": [...], "reach": [...]}
  createdAt   DateTime @default(now())

  @@index([userId])
}

model SupportTicket {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String                 // "open" | "in_progress" | "resolved" | "closed"
  priority  String                 // "low" | "normal" | "high" | "urgent"
  messages  SupportTicketMessage[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([userId])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType String        // "client" | "agency"
  senderName String
  message    String        @db.Text
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

model ClientInvoice {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber    String   @unique
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("TRY")
  status           String   // "paid" | "pending" | "overdue"
  issueDate        DateTime
  dueDate          DateTime
  pdfUrl           String?
  relatedProjectId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model ClientContract {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  signedAt  DateTime?
  status    String    // "draft" | "sent" | "signed"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   // "project" | "invoice" | "report" | "support" | "contract" | "account"
  link        String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model ClientTeamMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  role      String   // "viewer" | "approver" | "manager"
  status    String   @default("active") // "invited" | "active"
  invitedAt DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// PAYTR ABONELİK & ÖDEME SİSTEMİ (PCI-DSS Uyumlu, HAM KART YOK)
// ═══════════════════════════════════════════════════════════════════════════════

enum SubscriptionStatus {
  ACTIVE     // Aktif, tahsilat devam ediyor
  PAST_DUE   // Tahsilat başarısız, 24 saatlik grace period
  CANCELED   // Kullanıcı veya sistem tarafından iptal edildi
  TRIALING   // Deneme süresi (gelecekte kullanım)
  EXPIRED    // Dönem sonu geldi, yenileme yapılmadı
}

enum PaymentStatus {
  SUCCESS  // Başarılı tahsilat
  FAILED   // Başarısız tahsilat
  PENDING  // Bekliyor (3d secure akışı devam ediyor vb.)
}

// ─── Abonelik Planı (Genel Amaçlı) ───────────────────────────────────────────
model SubscriptionPlan {
  id              String     @id @default(cuid())
  name            String                          // "Aylık Pro Paketi"
  slug            String     @unique              // "pro-monthly"
  price_monthly_tl Float                           // Aylık TL tutarı
  interval_days   Int        @default(30)         // Varsayılan 30 gün
  isActive        Boolean    @default(true)
  description     String?    @db.Text
  features        String[]                       // ["Sınırsız ürün", "24/7 Destek", ...]

  productId       String?
  product         Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  subscriptions   Subscription[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([productId])
  @@index([isActive])
}

// ─── Saklı Ödeme Kartı (PCI-DSS Uyumlu) ─────────────────────────────────────
// DİKKAT: HİÇBİR ZAMAN ham kart numarası, CVV, SKT saklanmaz.
// Sadece PayTR'ın döndürdüğü TOKEN (utoken/ctoken) ve maskelenmiş gösterim tutulur.
model SavedPaymentCard {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PayTR Kart Saklama Token'ları (EN KRİTİK alanlar)
  utoken         String                            // PayTR user token (saklı kart için)
  ctoken         String?                           // PayTR card token (varsa)

  // ── Sadece gösterim amaçlı, HAM bilgi YOK ──
  masked_card_no String                            // 415565******1234
  card_brand     String?                           // "visa" | "mastercard" | "troy" | "amex"
  card_type      String?                           // "debit" | "credit" | "prepaid"
  expires_at     String?                           // YYMM formatı (sadece gösterim amaçlı)

  // Kullanıcı için varsayılan kart
  isDefault      Boolean    @default(false)

  subscriptions  Subscription[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@index([isDefault])
}

// ─── Abonelik ────────────────────────────────────────────────────────────────
model Subscription {
  id                     String              @id @default(cuid())
  userId                 String
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId                 String?
  plan                   SubscriptionPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  productId              String?
  product                Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Kayıtlı kart ilişkisi (varsayılan kartı güncellemek için)
  savedCardId            String?
  savedCard              SavedPaymentCard?   @relation(fields: [savedCardId], references: [id], onDelete: SetNull)

  status                 SubscriptionStatus  @default(ACTIVE)

  // Dönem takibi
  current_period_start   DateTime
  current_period_end     DateTime
  next_charge_at         DateTime

  // İptal yönetimi
  cancel_at_period_end   Boolean             @default(false)
  canceled_at            DateTime?
  cancel_reason          String?

  // Tahsilat başarısız olduğunda past_due durumuna geçiş zamanı
  past_due_at            DateTime?

  // Proration kredisi (düşürme sonrası kalan tutar)
  proration_credit       Float               @default(0)

  // Abonelik başladığındaki fiyat (price snapshot)
  price_snapshot         Float

  // HATIRLATMA takibi (tek gönderim garantisi)
  reminder_sent_at       DateTime?

  paymentAttempts        PaymentAttempt[]

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([productId])
  @@index([status, next_charge_at])
  @@index([cancel_at_period_end])
}

// ─── Ödeme Denemesi / İşlem (Transaction) ────────────────────────────────────
model PaymentAttempt {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId      String?
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  orderId             String?
  order               Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  amount              Float                           // Tahsil edilen tutar (TL, ondalıklı)
  currency            String        @default("TRY")

  status              PaymentStatus @default(PENDING)

  // PayTR Benzersiz İşlem Numaraları (idempotency için unique)
  paytr_merchant_oid  String        @unique
  paytr_transaction_id String?

  // Hata detayları (başarısızsa)
  error_code          String?
  error_message       String?

  // Gösterim amaçlı (kartın kendisi değil, maskelenmiş)
  masked_card_no      String?

  // İşlem türü
  is_recurring        Boolean       @default(false) // true = otomatik tekrarlayan
  attempt_number      Int           @default(1)     // Tekrar deneme sayısı

  // Notlar / ham response maskelenmiş (debug için)
  raw_response        Json?

  createdAt           DateTime      @default(now())

  @@index([userId])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

